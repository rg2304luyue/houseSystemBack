# 数据库配置
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=flaskhousesystem

# Redis
REDIS_URL=redis://@localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://@localhost:6379/1
CELERY_RESULT_BACKEND=redis://@localhost:6379/1

# JWT 密钥
SECRET_KEY=your-secret-key

# AI (DashScope / Qwen)
DASHSCOPE_API_KEY=your-dashscope-key

# 高德地图
GAODE_WEATHER_KEY=your-gaode-key
GAODE_MAP_KEY=your-gaode-key
GAODE_MAP_SAFE_KEY=your-gaode-key

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://127.0.0.1:5000/github/callback

# 阿里云 OSS
OSS_ACCESS_KEY_ID=your-oss-key
OSS_ACCESS_KEY_SECRET=your-oss-secret
OSS_BUCKET_NAME=flaskhousesystem
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
