# ============================================
# 链居 - 环境变量模板
# 部署时复制为 .env 并填入真实值
# ============================================

# ---- 数据库 ----
MYSQL_USER=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DB=

# ---- Redis ----
REDIS_URL=redis://@localhost:6379/0

# ---- Celery ----
CELERY_BROKER_URL=redis://@localhost:6379/1
CELERY_RESULT_BACKEND=redis://@localhost:6379/1

# ---- Gunicorn ----
GUNICORN_WORKERS=4

# ---- Flask / JWT ----
SECRET_KEY=

# ---- AI chat (DeepSeek) ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-v4-flash

# ---- RAG embeddings (DashScope; required only for knowledge retrieval/indexing) ----
DASHSCOPE_API_KEY=
AI_EMBEDDING_MODEL=qwen3.7-text-embedding

# ---- 高德地图 ----
GAODE_WEATHER_KEY=
GAODE_MAP_KEY=
GAODE_MAP_SAFE_KEY=

# ---- GitHub OAuth ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# ---- 阿里云 OSS ----
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=
OSS_REGION=

# ---- QQ 邮箱 SMTP ----
QQ_SMTP_EMAIL=
QQ_SMTP_AUTH_CODE=
