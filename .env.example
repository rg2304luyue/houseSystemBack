# ============================================
# 链居 - 环境变量模板
# 部署时复制为 .env 并填入真实值
# ============================================

# ---- 数据库 ----
MYSQL_USER=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DB=

# ---- Redis ----
REDIS_URL=redis://@localhost:6379/0

# ---- Celery ----
CELERY_BROKER_URL=redis://@localhost:6379/1
CELERY_RESULT_BACKEND=redis://@localhost:6379/1

# ---- Gunicorn ----
GUNICORN_WORKERS=4

# ---- Flask / JWT ----
SECRET_KEY=

# ---- AI chat (DeepSeek) ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-v4-flash
AI_DEEPSEEK_CONNECT_TIMEOUT_SECONDS=5
AI_DEEPSEEK_READ_TIMEOUT_SECONDS=45

# ---- RAG embeddings (DashScope; required only for knowledge retrieval/indexing) ----
DASHSCOPE_API_KEY=
AI_EMBEDDING_MODEL=qwen3.7-text-embedding
AI_DASHSCOPE_TIMEOUT_SECONDS=30

# ---- AI reliability (run one Uvicorn worker for machine-wide local limits) ----
AI_PROVIDER_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_SECONDS=0.5
AI_RETRY_MAX_DELAY_SECONDS=8
AI_AGENT_MAX_CONCURRENT=4
AI_AGENT_MAX_CONCURRENT_PER_USER=1
AI_RUN_MAX_ATTEMPTS=3
AI_RUN_LEASE_SECONDS=180
AI_PROVIDER_MAX_CONCURRENT=3
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_OPEN_SECONDS=30

# ---- 高德地图 ----
GAODE_WEATHER_KEY=
GAODE_MAP_KEY=
GAODE_MAP_SAFE_KEY=

# ---- GitHub OAuth ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# ---- 阿里云 OSS ----
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=
OSS_REGION=

# ---- QQ 邮箱 SMTP ----
QQ_SMTP_EMAIL=
QQ_SMTP_AUTH_CODE=

# ---- 支付宝（生产环境必须全部配置，回调与跳转地址必须为 HTTPS） ----
ALIPAY_APP_ID=2021000148684222
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=exts/app_private_key.txt
ALIPAY_PUBLIC_KEY_PATH=exts/alipay_public_key.txt
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=http://127.0.0.1:8000/api/v1/payments/notify
ALIPAY_RETURN_URL=http://127.0.0.1:4399/alipay/payment-result
PAYMENT_MOCK_ENABLED=true
